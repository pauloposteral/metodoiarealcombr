# Public browser configuration. Never put service-role, database or payment secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project
# Optional analytics: loaded only after consent.
VITE_META_PIXEL_ID=
VITE_GA_MEASUREMENT_ID=
# Optional WhatsApp number: country code + area code + number, digits only.
# Empty value uses the existing support email address.
VITE_WHATSAPP_NUMBER=
