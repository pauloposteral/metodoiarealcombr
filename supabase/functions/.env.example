# SERVER ONLY. Copy into a private local file; never commit real secrets.
# Supabase normally injects these three automatically into hosted Edge Functions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=https://metodoiareal.com.br
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LOVABLE_API_KEY=
# Configure a random value of at least 32 characters in Greenn's webhook URL
# (?token=...) or in an integration adapter's x-webhook-token header.
GREENN_WEBHOOK_SECRET=
# Exact numeric IDs of the course products allowed to grant access.
GREENN_PRODUCT_IDS=
# Optional restriction for URL scraping. Comma-separated exact DNS hostnames.
SCRAPE_ALLOWED_HOSTS=
